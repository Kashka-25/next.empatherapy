# Copy to .env.local for local work (that file is git-ignored). On a host, set these in its secret settings.
# Never put real values in this file, and never prefix any of these with NEXT_PUBLIC_.

# Storage: leave unset to switch storage and the admin off. "file" is for local work only. "supabase" is for hosting.
EMPATHERAPY_STORE=file

# Admin sessions: 32 or more random characters.
ADMIN_SESSION_SECRET=

# One-time setup password hash, made with `npm run admin:hash`. Only used to create the first owner account;
# it stops working once an owner exists, and should then be removed from the host.
ADMIN_PASSWORD_HASH=

# Supabase (only when EMPATHERAPY_STORE=supabase). Server-side only: the service-role key bypasses row-level security.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
